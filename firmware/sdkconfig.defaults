CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Native USB-Serial-JTAG carries the console so the recovery/export command
# surface stays available over the USB-C port when Wi-Fi is unavailable.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The revision-A module carries 8 MB flash; the Wi-Fi + HTTP image exceeds
# the 1 MB default single-app partition.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
