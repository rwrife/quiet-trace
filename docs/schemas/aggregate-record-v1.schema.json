{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiet-trace.local/schemas/aggregate-record-v1.schema.json",
  "title": "Quiet Trace aggregate record v1",
  "description": "One closed, aggregate-only 60-second record. Unknown properties are rejected. Raw/encoded audio, samples, spectra, transcripts, identity, credentials, and secrets have no representable field. Standard JSON Schema validates the structural constraints; the declared Quiet Trace semantic validator is also required for aggregate invariants that Draft 2020-12 cannot express.",
  "$comment": "The x-quiet-trace-total and x-quiet-trace-peak-gte-equivalent keywords are semantic annotations to standard validators. Consumers MUST also run one of the declared semantic validator implementations.",
  "x-quiet-trace-semantic-validation": {
    "required": true,
    "rules": [
      "histogram_total_480",
      "peak_gte_equivalent",
      "valid_unicode_scalar_text",
      "clock_quality_wall_time_consistency"
    ],
    "implementations": {
      "typescript": "app/src/contracts/aggregate-record.ts#parseAggregateRecord",
      "cpp": "firmware/components/domain/aggregate_contract.cpp#is_valid"
    }
  },
  "type": "object",
  "required": [
    "schema",
    "sequence",
    "interval_start",
    "monotonic_start_ms",
    "duration_ms",
    "level_eq_dbfs",
    "peak_125ms_dbfs",
    "histogram_counts",
    "calibration",
    "clock_quality",
    "quality_flags",
    "session_id"
  ],
  "properties": {
    "schema": { "const": "quiet-trace/aggregate/v1" },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "interval_start": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
        },
        { "type": "null" }
      ]
    },
    "monotonic_start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration_ms": { "const": 60000 },
    "level_eq_dbfs": { "type": "number", "minimum": -200, "maximum": 0 },
    "peak_125ms_dbfs": { "type": "number", "minimum": -200, "maximum": 0 },
    "histogram_counts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "type": "integer", "minimum": 0 },
      "x-quiet-trace-total": 480
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "offset_db",
        "calibrated_at",
        "method",
        "reference_instrument",
        "reference_placement",
        "reference_source",
        "reference_duration_s",
        "firmware_version",
        "hardware_revision"
      ],
      "properties": {
        "state": {
          "enum": ["uncalibrated", "reference_adjusted", "invalid"]
        },
        "offset_db": {
          "oneOf": [
            { "type": "number", "minimum": -80, "maximum": 80 },
            { "type": "null" }
          ]
        },
        "calibrated_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
            },
            { "type": "null" }
          ]
        },
        "method": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 240 },
            { "type": "null" }
          ]
        },
        "reference_instrument": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 160 },
            { "type": "null" }
          ]
        },
        "reference_placement": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 240 },
            { "type": "null" }
          ]
        },
        "reference_source": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 240 },
            { "type": "null" }
          ]
        },
        "reference_duration_s": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 86400 },
            { "type": "null" }
          ]
        },
        "firmware_version": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 64 },
            { "type": "null" }
          ]
        },
        "hardware_revision": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 64 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "reference_adjusted" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "offset_db": {
                "type": "number",
                "minimum": -80,
                "maximum": 80
              },
              "calibrated_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
              },
              "method": { "type": "string", "minLength": 1, "maxLength": 240 },
              "reference_instrument": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "reference_placement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "reference_source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "reference_duration_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "firmware_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "hardware_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "else": {
            "properties": {
              "offset_db": { "type": "null" },
              "calibrated_at": { "type": "null" },
              "method": { "type": "null" },
              "reference_instrument": { "type": "null" },
              "reference_placement": { "type": "null" },
              "reference_source": { "type": "null" },
              "reference_duration_s": { "type": "null" },
              "firmware_version": { "type": "null" },
              "hardware_revision": { "type": "null" }
            }
          }
        }
      ]
    },
    "clock_quality": {
      "enum": ["unknown", "monotonic_only", "host_set", "synced"]
    },
    "quality_flags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,47}$"
      }
    },
    "session_id": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 64 },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "clock_quality": { "enum": ["unknown", "monotonic_only"] }
        },
        "required": ["clock_quality"]
      },
      "then": { "properties": { "interval_start": { "type": "null" } } },
      "else": { "properties": { "interval_start": { "type": "string" } } }
    }
  ],
  "additionalProperties": false,
  "x-quiet-trace-peak-gte-equivalent": true
}
